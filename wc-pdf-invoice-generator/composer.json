{
    "name": "wp-xpert/wc-pdf-invoice-generator",
    "description": "WordPress Plugin zur Generierung von PDF-Rechnungen für WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WP Xpert",
            "email": "info@wp-xpert.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "tecnickcom/tcpdf": "^6.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true
    }
}
